# TaxIntel API Server - copy to .env and fill in your values.
# SECURITY: This file is safe to commit. Never commit .env with real secrets.

# Supabase project URL (Supabase Dashboard > Settings > API > Project URL)
TAXINTEL_DB_URL=https://your-project-ref.supabase.co

# Supabase service_role key - backend only, never put this in frontend code.
# Rotate any key that has ever been committed or shared.
TAXINTEL_DB_KEY=replace-with-service-role-key

# Comma-separated frontend origins allowed to call the API.
# Leave empty only for local development.
TAXINTEL_CORS_ORIGIN=http://localhost:5173

# Optional local demo seeding. Keep disabled outside local sandboxes.
TAXINTEL_SEED_DEMO_USERS=false
TAXINTEL_DEMO_PASSWORD=

NODE_ENV=development
PORT=8080
